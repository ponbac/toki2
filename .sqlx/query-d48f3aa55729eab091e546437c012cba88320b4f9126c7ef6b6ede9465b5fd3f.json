  "query": "\n            SELECT account_id, day, SUM(gross_usd_nanos)::int8 AS \"gross!\"\n            FROM ai_provider_account_usage\n            WHERE provider = $1 AND day >= $2 AND day < $3\n            GROUP BY account_id, day\n            ORDER BY account_id, day\n            ",
