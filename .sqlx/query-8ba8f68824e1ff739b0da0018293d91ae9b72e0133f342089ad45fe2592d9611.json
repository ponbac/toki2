  "query": "\n            INSERT INTO ai_subscriptions (\n                user_id, provider, plan, monthly_cost, currency, valid_from, valid_to\n            )\n            VALUES ($1, $2, $3, $4::int8 / 100.0, $5, $6, $7)\n            RETURNING\n                id,\n                user_id,\n                provider,\n                plan,\n                (monthly_cost * 100)::int8 AS \"monthly_cost_hundredths!\",\n                currency,\n                valid_from,\n                valid_to\n            ",
