  "query": "\n                SELECT account_id, month, error AS \"error!\"\n                FROM ai_provider_usage_checks\n                WHERE provider = $1\n                  AND source = 'account_credits'\n                  AND error IS NOT NULL\n                  AND checked_at >= $2\n                ORDER BY month, account_id\n                ",
