  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                log.machine_id::text AS \"machine_id!\",\n                log.provider,\n                log.window_start,\n                log.covered_until\n            FROM ai_usage_coverage_log AS log\n            WHERE log.covered_until > $1 AND log.window_start < $2\n            ORDER BY log.machine_id, log.provider, log.window_start\n            ",
