{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                user_id,\n                provider,\n                plan,\n                (monthly_cost * 100)::int8 AS \"monthly_cost_hundredths!\",\n                currency,\n                valid_from,\n                valid_to\n            FROM ai_subscriptions\n            WHERE ($1::int4 IS NULL OR user_id = $1)\n            ORDER BY user_id, provider, valid_from DESC\n            ",
