  "query": "\n            SELECT user_id, client_id, client_name, redirect_uri, resource, code_challenge,\n                   expires_at, consumed_at IS NOT NULL AS \"consumed!\", grant_id\n            FROM oauth_authorization_codes\n            WHERE code_hash = $1\n            FOR UPDATE\n            ",
